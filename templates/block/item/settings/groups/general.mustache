<div class="activitycopycart-settings-group mb-4">
    <h6 class="activitycopycart-group-title">{{#str}}settingsgeneral, block_activity_copy_cart {{/str}}</h6>
    <div class="form-group mb-3">
        <label for="rename-input-{{cmid}}" class="form-label font-weight-bold">
            {{#str}} renameactivity, block_activity_copy_cart {{/str}}
            <i class="icon fa fa-question-circle text-info fa-fw activitycopycart-info-icon" data-toggle="tooltip" data-placement="right"
                tabindex="0" role="img"
                title="{{#str}} rename_info, block_activity_copy_cart {{/str}}"
                aria-label="{{#str}} rename_info, block_activity_copy_cart {{/str}}"></i>
        </label>
        <input type="text" class="form-control" id="rename-input-{{cmid}}" value="{{cmName}}">
    </div>
    <div class="form-group mb-3">
        <label class="form-label font-weight-bold d-block">
            {{#str}} nameconflict, block_activity_copy_cart {{/str}}
            <i class="icon fa fa-question-circle text-info fa-fw activitycopycart-info-icon" data-toggle="tooltip" data-placement="right"
                tabindex="0" role="img"
                title="{{#str}} nameconflict_info, block_activity_copy_cart {{/str}}"
                aria-label="{{#str}} nameconflict_info, block_activity_copy_cart {{/str}}"></i>
        </label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="nameconflict-{{cmid}}"
                    id="nameconflict-resolve-{{cmid}}" value="resolve"
                    {{#nameconflictresolve}}checked{{/nameconflictresolve}}>
            <label class="form-check-label" for="nameconflict-resolve-{{cmid}}">
                {{#str}} resolveconflict, block_activity_copy_cart {{/str}}
            </label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="nameconflict-{{cmid}}"
                    id="nameconflict-skip-{{cmid}}" value="skip"
                    {{#nameconflictskip}}checked{{/nameconflictskip}}>
            <label class="form-check-label" for="nameconflict-skip-{{cmid}}">
                {{#str}} skipactivity, block_activity_copy_cart {{/str}}
            </label>
        </div>
    </div>
</div>
